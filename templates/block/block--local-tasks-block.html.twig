{% extends "block.html.twig" %}
{#
/**
 * @file
 * Theme override for tabs.
 */
#}
{% block content %}
  {% if content %}
    {% embed 'localgov_base:section' with {
      section_inner_classes: [ 'tabs' ],
      section_outer_attributes: create_attribute({
        'aria-label': 'Tabs'|t,
        role: 'navigation',
      }),
      section_outer_element: 'nav',
    } %}
      {% block section_content %}
        {{ content }}
      {% endblock %}
    {% endembed %}
  {% endif %}
{% endblock %}
